        "jsCode": "// keyword set to sweep — edit freely\nreturn [\n  { json: { q: 'AI automation' } },\n  { json: { q: 'GoHighLevel' } },\n  { json: { q: 'n8n' } },\n  { json: { q: 'make.com automation' } }\n];"
